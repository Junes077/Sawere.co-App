# ---------------------------------------------------------------------------
# Sawere Legal OS — environment configuration
# Copy this file to .env.local (dev) and fill in real values.
# Never commit .env* files with real secrets.
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key — server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Database (Prisma) ---------------------------------------------------
# Pooled connection (used at runtime) and direct connection (used for migrations).
# Project Settings > Database in your Supabase dashboard.
DATABASE_URL="postgresql://postgres:PASSWORD@YOUR_PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@YOUR_PROJECT.pooler.supabase.com:5432/postgres"

# --- AI providers ---------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- OAuth (configured in Supabase Auth > Providers, referenced here for
# local callback URLs / feature flags) --------------------------------------
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=false

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Sawere Legal OS"

# --- Future integrations (leave unset until you wire them up) --------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
WHATSAPP_BUSINESS_TOKEN=
